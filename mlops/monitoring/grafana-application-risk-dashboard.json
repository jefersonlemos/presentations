{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.35},
              {"color": "orange", "value": 0.65},
              {"color": "red", "value": 0.85}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showUnfilled": true,
        "valueMode": "color"
      },
      "targets": [
        {
          "expr": "failure_model_app_risk_score",
          "instant": true,
          "legendFormat": "{{ app }}",
          "refId": "A"
        }
      ],
      "title": "Technical Risk by Application",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false},
        "showHeader": true
      },
      "targets": [
        {
          "expr": "failure_model_app_predicted_failure == 1",
          "format": "table",
          "instant": true,
          "legendFormat": "{{ app }} - {{ failure_type }}",
          "refId": "A"
        }
      ],
      "title": "Current Predicted Failure Mode",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true, "Value": true},
            "indexByName": {"app": 0, "failure_type": 1},
            "renameByName": {"app": "Application", "failure_type": "Predicted failure"}
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 12, "lineWidth": 2, "showPoints": "never"},
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"expr": "failure_model_app_risk_score", "legendFormat": "{{ app }}", "refId": "A"}
      ],
      "title": "Technical Risk Over Time",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never"},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "expr": "failure_model_app_signal{signal=\"memory_usage_pct\"}",
          "legendFormat": "{{ app }} memory",
          "refId": "A"
        },
        {
          "expr": "failure_model_app_signal{signal=\"cpu_usage_pct\"}",
          "legendFormat": "{{ app }} cpu",
          "refId": "B"
        }
      ],
      "title": "CPU and Memory Signals",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "bars", "fillOpacity": 35, "lineWidth": 1, "showPoints": "never"},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 5,
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "expr": "failure_model_app_signal{signal=\"restart_count\"}",
          "legendFormat": "{{ app }} restarts",
          "refId": "A"
        },
        {
          "expr": "failure_model_app_signal{signal=\"readiness_probe_failures\"}",
          "legendFormat": "{{ app }} probe failures",
          "refId": "B"
        },
        {
          "expr": "failure_model_app_signal{signal=\"oom_killed_count\"}",
          "legendFormat": "{{ app }} OOM kills",
          "refId": "C"
        }
      ],
      "title": "Failure Symptoms",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "bars", "fillOpacity": 65, "lineWidth": 1, "showPoints": "never", "stacking": {"group": "A", "mode": "normal"}},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 6,
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "expr": "sum by (app, failure_type) (increase(failure_model_app_predictions_total[15m]))",
          "legendFormat": "{{ app }} - {{ failure_type }}",
          "refId": "A"
        }
      ],
      "title": "Predictions by Application and Failure Type",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "reqps"},
        "overrides": []
      },
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 24},
      "id": 7,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "targets": [
        {"expr": "sum(rate(failure_model_prediction_requests_total[2m]))", "legendFormat": "requests", "refId": "A"}
      ],
      "title": "Prediction Traffic",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "ms"},
        "overrides": []
      },
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 24},
      "id": 8,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.50, sum(rate(failure_model_prediction_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "1000 * histogram_quantile(0.95, sum(rate(failure_model_prediction_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "title": "Prediction Latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"0": {"color": "red", "text": "DOWN"}, "1": {"color": "green", "text": "UP"}}, "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 24},
      "id": 9,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "name"
      },
      "targets": [
        {"expr": "up{job=~\"failure-model-api|failure-model-kserve\"}", "legendFormat": "{{ job }}", "refId": "A"}
      ],
      "title": "Serving Health",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 0.6},
              {"color": "yellow", "value": 0.8},
              {"color": "green", "value": 0.9}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 7, "w": 6, "x": 0, "y": 31},
      "id": 10,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(failure_model_correct_predictions_total[5m])) / clamp_min(sum(increase(failure_model_labeled_predictions_total[5m])), 1)",
          "legendFormat": "accuracy",
          "refId": "A"
        }
      ],
      "title": "Production Accuracy (2m)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 18, "lineWidth": 2, "showPoints": "never"},
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 7, "w": 12, "x": 6, "y": 31},
      "id": 11,
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "expr": "sum(increase(failure_model_correct_predictions_total[5m])) / clamp_min(sum(increase(failure_model_labeled_predictions_total[5m])), 1)",
          "legendFormat": "production accuracy",
          "refId": "A"
        },
        {
          "expr": "1 - (sum(increase(failure_model_correct_predictions_total[5m])) / clamp_min(sum(increase(failure_model_labeled_predictions_total[5m])), 1))",
          "legendFormat": "error rate",
          "refId": "B"
        }
      ],
      "title": "Model Quality Over Time",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"0": {"color": "red", "text": "WRONG"}, "1": {"color": "green", "text": "CORRECT"}}, "type": "value"}
          ]
        },
        "overrides": []
      },
      "gridPos": {"h": 7, "w": 6, "x": 18, "y": 31},
      "id": 12,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "name"
      },
      "targets": [
        {
          "expr": "failure_model_app_prediction_correct",
          "instant": true,
          "legendFormat": "{{ app }}",
          "refId": "A"
        }
      ],
      "title": "Latest Ground-Truth Match",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 38},
      "id": 13,
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "expr": "sum by (expected_failure_type, predicted_failure_type) (increase(failure_model_prediction_confusion_total[5m]))",
          "legendFormat": "expected={{ expected_failure_type }} predicted={{ predicted_failure_type }}",
          "refId": "A"
        }
      ],
      "title": "Production Confusion: Expected vs Predicted",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.35},
              {"color": "orange", "value": 0.65},
              {"color": "red", "value": 0.85}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 46},
      "id": 14,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showUnfilled": true,
        "valueMode": "color"
      },
      "targets": [
        {
          "expr": "(failure_model_app_risk_score * on(app) failure_model_app_criticality_score * on(app) (sum by (app) (rate(failure_model_app_traffic_total[5m])) / clamp_min(sum(rate(failure_model_app_traffic_total[5m])), 0.001)))",
          "instant": true,
          "legendFormat": "{{ app }}",
          "refId": "A"
        }
      ],
      "title": "Business Risk by Application",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.35},
              {"color": "orange", "value": 0.65},
              {"color": "red", "value": 0.85}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 46},
      "id": 15,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showUnfilled": true,
        "valueMode": "color"
      },
      "targets": [
        {
          "expr": "sum by (app) (rate(failure_model_app_traffic_total[5m])) / clamp_min(sum(rate(failure_model_app_traffic_total[5m])), 0.001)",
          "instant": true,
          "legendFormat": "{{ app }}",
          "refId": "A"
        }
      ],
      "title": "Traffic Share by Application",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 46},
      "id": 16,
      "options": {
        "cellHeight": "sm",
        "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false},
        "showHeader": true
      },
      "targets": [
        {
          "expr": "failure_model_app_criticality == 1",
          "format": "table",
          "instant": true,
          "legendFormat": "{{ app }} - {{ criticality }}",
          "refId": "A"
        }
      ],
      "title": "Application Criticality Metadata",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true, "Value": true},
            "indexByName": {"app": 0, "criticality": 1},
            "renameByName": {"app": "Application", "criticality": "Criticality"}
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["mlops", "application-risk", "kserve"],
  "time": {"from": "now-30m", "to": "now"},
  "timezone": "browser",
  "title": "Kubernetes Application Failure Risk",
  "uid": "kubernetes-application-risk",
  "version": 1
}
